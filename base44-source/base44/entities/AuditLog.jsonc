{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "string",
      "description": "request_submitted, cancelled, expired, processing_started, tool_scanned, scan_rejected, override_recorded, release_partial, release_completed, return_confirmed, damage_reported, loss_reported"
    },
    "request_ref": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "rejected"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "ok"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
